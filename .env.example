# Pegue estas chaves em: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# (RECOMENDADO) Servidor TURN para evitar tela preta em redes CGNAT / NAT simétrico / 4G / VPN
# Opção 1: Cloudflare Calls TURN (1 TB grátis/mês -> https://dash.cloudflare.com -> Calls -> TURN)
# CLOUDFLARE_TURN_TOKEN_ID=seu-turn-token-id
# CLOUDFLARE_TURN_API_TOKEN=seu-turn-api-token
#
# Opção 2: Metered.ca TURN (50 GB grátis/mês -> https://www.metered.ca/tools/openrelay/)
# METERED_APP_NAME=seu-app
# METERED_API_KEY=sua-api-key
#
# Opção 3: Servidor TURN próprio (coturn / Xirsys / Twilio)
# TURN_URL=turn:seu-servidor:3478,turns:seu-servidor:443?transport=tcp
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha
